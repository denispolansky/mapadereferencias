---
import Base from '../layouts/Base.astro';
import { getTodasLasEntradas, extraerSlugsReferenciados } from '../lib/entradas';
import { formatearFecha, rutaMedia, tiempoRelativo } from '../lib/formato';

const entradas = await getTodasLasEntradas();

const ultimaActualizacion = entradas.length
  ? new Date(Math.max(...entradas.map((e) => (e.data.modificado as Date).getTime())))
  : null;

const conteoBacklinks = new Map<string, number>();
for (const e of entradas) {
  for (const slug of extraerSlugsReferenciados(e.body)) {
    conteoBacklinks.set(slug, (conteoBacklinks.get(slug) ?? 0) + 1);
  }
}

const ESCALA_POR_ESTADO: Record<string, string> = {
  estable: 'grande',
  'en-desarrollo': 'media',
  semilla: 'chica',
};

const items = entradas
  .map((e) => {
    const imagen = e.data.archivo ?? e.data.imagenes?.[0] ?? null;
    return {
      slug: e.slug,
      tipo: e.tipo,
      titulo: e.data.titulo,
      fecha: e.data.fecha as Date,
      estado: e.data.estado as string,
      etiquetas: (e.data.etiquetas ?? []) as string[],
      conexiones: conteoBacklinks.get(e.slug) ?? 0,
      imagen,
      escala: ESCALA_POR_ESTADO[e.data.estado] ?? 'media',
    };
  })
  .sort((a, b) => b.fecha.getTime() - a.fecha.getTime());
---
<Base titulo="índice">
  {ultimaActualizacion && (
    <p class="archivo-vivo">
      {entradas.length} {entradas.length === 1 ? 'entrada' : 'entradas'} · última actualización {tiempoRelativo(ultimaActualizacion)}
    </p>
  )}
  <div class="controles-indice">
    <span>ordenar por</span>
    <button type="button" data-orden="fecha" class="activo">fecha</button>
    <button type="button" data-orden="titulo">título</button>
  </div>
  <ul class="muro" id="indice">
    {items.map((item) => {
      const esGrande = item.imagen && item.escala === 'grande';
      const claseCelda = !item.imagen ? 'nota' : esGrande ? 'imagen-2' : 'imagen-1';
      return (
        <li class:list={['celda', claseCelda]} data-fecha={item.fecha.toISOString()} data-titulo={item.titulo}>
          {item.imagen && (
            <a class="marco" href={`/${item.tipo}/${item.slug}`}>
              <img src={rutaMedia(item.imagen)} alt="" loading="lazy" />
            </a>
          )}
          <div class="contenido">
            <a class:list={['titulo', `titulo-${item.escala}`]} href={`/${item.tipo}/${item.slug}`}>{item.titulo}</a>
            <span class="ficha">{item.tipo} · {item.estado} · {formatearFecha(item.fecha)}</span>
            {item.etiquetas.length > 0 && (
              <span class="etiquetas">
                {item.etiquetas.map((et, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/etiqueta/${et}`}>{et}</a>
                  </>
                ))}
              </span>
            )}
            {item.conexiones > 0 && (
              <span class="conexiones">{item.conexiones} {item.conexiones === 1 ? 'conexión' : 'conexiones'}</span>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</Base>
<style>
  :global(main:has(.muro)) {
    max-width: 68rem;
  }
  .archivo-vivo {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #999;
    margin: 0 0 2rem;
  }
  .controles-indice {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #777;
    margin-bottom: 2.5rem;
  }
  .controles-indice button {
    font: inherit;
    background: none;
    border: none;
    color: #777;
    cursor: pointer;
    padding: 0 0.3rem;
    text-decoration: underline;
  }
  .controles-indice button.activo {
    color: #111;
    text-decoration: none;
    font-weight: 600;
  }
  .muro {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: row dense;
    column-gap: 2rem;
    row-gap: 3rem;
  }
  .celda {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .celda.imagen-1 {
    grid-column: span 1;
  }
  .celda.imagen-2 {
    grid-column: span 2;
  }
  .celda.nota {
    grid-column: span 2;
    border-top: 1px solid #e5e5e5;
    padding-top: 1.5rem;
  }
  .marco {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .imagen-2 .marco {
    aspect-ratio: 3 / 2;
  }
  .marco img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fafaf8;
  }
  .contenido {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .titulo {
    color: #111;
    text-decoration: none;
  }
  .titulo:hover {
    text-decoration: underline;
  }
  .titulo-chica {
    font-size: 1rem;
    font-weight: 400;
    color: #333;
  }
  .titulo-media {
    font-size: 1.15rem;
    font-weight: 500;
  }
  .titulo-grande {
    font-size: 1.5rem;
    font-weight: 600;
  }
  .ficha {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #999;
  }
  .etiquetas {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
  }
  .etiquetas a {
    color: #777;
    text-decoration: none;
  }
  .etiquetas a:hover {
    text-decoration: underline;
  }
  .conexiones {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: #b0aca2;
  }
  .conexiones::before {
    content: '⌁ ';
  }
  @media (max-width: 40rem) {
    .muro {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.25rem;
      row-gap: 2.25rem;
    }
  }
  @media (max-width: 26rem) {
    .muro {
      grid-template-columns: 1fr;
    }
    .celda.imagen-1,
    .celda.imagen-2,
    .celda.nota {
      grid-column: span 1;
    }
  }
</style>
<script>
  const contenedor = document.getElementById('indice');
  const botones = document.querySelectorAll('.controles-indice button');
  if (contenedor) {
    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const orden = boton.getAttribute('data-orden');
        const items = Array.from(contenedor.children) as HTMLElement[];
        items.sort((a, b) => {
          if (orden === 'titulo') {
            return (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '');
          }
          return (b.dataset.fecha ?? '').localeCompare(a.dataset.fecha ?? '');
        });
        items.forEach((item) => contenedor.appendChild(item));
        botones.forEach((b) => b.classList.remove('activo'));
        boton.classList.add('activo');
      });
    });
  }
</script>
