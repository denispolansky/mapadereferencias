---
import Base from '../layouts/Base.astro';
import { getTodasLasEntradas, extraerSlugsReferenciados } from '../lib/entradas';
import { formatearFecha, rutaMedia } from '../lib/formato';

const entradas = await getTodasLasEntradas();

const conteoBacklinks = new Map<string, number>();
for (const e of entradas) {
  for (const slug of extraerSlugsReferenciados(e.body)) {
    conteoBacklinks.set(slug, (conteoBacklinks.get(slug) ?? 0) + 1);
  }
}

const items = entradas
  .map((e) => {
    const imagen = e.data.archivo ?? e.data.imagenes?.[0] ?? null;
    return {
      slug: e.slug,
      tipo: e.tipo,
      titulo: e.data.titulo,
      fecha: e.data.fecha as Date,
      estado: e.data.estado as string,
      etiquetas: (e.data.etiquetas ?? []) as string[],
      fuente: ((e.data as any).fuente ?? null) as string | null,
      conexiones: conteoBacklinks.get(e.slug) ?? 0,
      imagen,
    };
  })
  .sort((a, b) => b.fecha.getTime() - a.fecha.getTime());
---
<Base titulo="índice">
  <div class="controles-indice">
    <div class="orden">
      <span>ordenar por</span>
      <button type="button" data-orden="fecha" class="activo">fecha</button>
      <button type="button" data-orden="titulo">título</button>
    </div>
    <div class="vista">
      <button type="button" data-vista="grilla" class="activo">grilla</button>
      <button type="button" data-vista="lista">lista</button>
    </div>
  </div>
  <div class="indice-vistas" id="indice-vistas" data-vista="grilla">
    <ul class="muro" id="indice">
      {items.map((item) => (
        <li class:list={['celda', item.imagen ? 'imagen' : 'nota']} data-fecha={item.fecha.toISOString()} data-titulo={item.titulo}>
          {item.imagen ? (
            <a class="marco" href={`/${item.tipo}/${item.slug}`}>
              <img src={rutaMedia(item.imagen)} alt="" loading="lazy" />
              <div class="cartel">
                <span class="titulo obra">{item.titulo}</span>
                <span class="ficha">{item.tipo} · {item.estado} · {formatearFecha(item.fecha)}</span>
                {item.conexiones > 0 && (
                  <span class="conexiones">{item.conexiones} {item.conexiones === 1 ? 'conexión' : 'conexiones'}</span>
                )}
              </div>
            </a>
          ) : (
            <div class="contenido">
              <a class="titulo obra" href={`/${item.tipo}/${item.slug}`}>{item.titulo}</a>
              <span class="ficha">{item.tipo} · {item.estado} · {formatearFecha(item.fecha)}</span>
              {item.conexiones > 0 && (
                <span class="conexiones">{item.conexiones} {item.conexiones === 1 ? 'conexión' : 'conexiones'}</span>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
    <table class="tabla" id="tabla-indice">
      <thead>
        <tr>
          <th>nombre</th>
          <th>formato</th>
          <th>fuente</th>
          <th>año</th>
          <th>etiquetas</th>
        </tr>
      </thead>
      <tbody>
        {items.map((item) => (
          <tr data-fecha={item.fecha.toISOString()} data-titulo={item.titulo}>
            <td><a class="titulo obra" href={`/${item.tipo}/${item.slug}`}>{item.titulo}</a></td>
            <td>{item.tipo}</td>
            <td>{item.fuente ?? '—'}</td>
            <td>{item.fecha.getFullYear()}</td>
            <td>{item.etiquetas.join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
<style>
  .controles-indice {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.8rem;
    color: #777;
    margin-bottom: 3rem;
  }
  .controles-indice button {
    font: inherit;
    background: none;
    border: none;
    color: #777;
    cursor: pointer;
    padding: 0 0.3rem;
    text-decoration: underline;
  }
  .controles-indice button.activo {
    color: var(--acento);
    text-decoration: none;
    font-weight: 600;
  }
  .vista {
    display: flex;
    gap: 0.25rem;
  }

  /* --- vista grilla (muro) --- */
  .muro {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, 9rem);
    justify-content: space-between;
    grid-auto-flow: row dense;
    column-gap: 2.5rem;
    row-gap: 4rem;
  }
  .celda {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .celda.nota {
    justify-content: flex-end;
    border-top: 1px solid #e8e6e1;
    padding-top: 1.5rem;
  }
  .marco {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    --x: 50%;
    --y: 50%;
  }
  .marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cartel {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.5rem 0.85rem;
    background: #fff;
    text-align: center;
    white-space: nowrap;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
    pointer-events: none;
  }
  .cartel .titulo {
    color: #141414;
    font-size: 0.85rem;
  }
  .cartel .ficha {
    color: #999;
    font-size: 0.68rem;
  }
  .cartel .conexiones {
    color: #b0aca2;
    font-size: 0.65rem;
  }
  @media (hover: hover) {
    .cartel {
      opacity: 0;
      transition: opacity 0.1s ease;
    }
    .marco:hover .cartel,
    .marco:focus-visible .cartel {
      opacity: 1;
    }
  }
  .contenido {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .titulo {
    font-size: 1.05rem;
    font-weight: 500;
    color: #141414;
    text-decoration: none;
  }
  .titulo:hover {
    text-decoration: underline;
  }
  .ficha {
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #999;
  }
  .conexiones {
    font-size: 0.7rem;
    color: #b0aca2;
  }
  .conexiones::before {
    content: '⌁ ';
  }

  /* --- vista lista (tabla) --- */
  .tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .tabla th,
  .tabla td {
    text-align: left;
    padding: 0.6rem 1rem 0.6rem 0;
    border-bottom: 1px solid #e8e6e1;
  }
  .tabla th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #999;
    font-weight: normal;
  }
  .tabla td:nth-child(2),
  .tabla td:nth-child(3),
  .tabla td:nth-child(4) {
    font-size: 0.78rem;
    color: #777;
  }
  .tabla td:last-child {
    font-size: 0.78rem;
    color: #999;
  }
  .tabla .titulo {
    font-size: 1rem;
  }

  .indice-vistas[data-vista='grilla'] .tabla {
    display: none;
  }
  .indice-vistas[data-vista='lista'] .muro {
    display: none;
  }

  @media (max-width: 65rem) {
    .muro {
      row-gap: 3rem;
    }
  }
  @media (max-width: 40rem) {
    .controles-indice {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .muro {
      grid-template-columns: repeat(auto-fill, 7.5rem);
      column-gap: 1.5rem;
      row-gap: 2.5rem;
    }
  }
</style>
<script>
  const contenedorMuro = document.getElementById('indice');
  const contenedorTabla = document.querySelector('#tabla-indice tbody');
  const indiceVistas = document.getElementById('indice-vistas');
  const botonesOrden = document.querySelectorAll('.orden button');
  const botonesVista = document.querySelectorAll('.vista button');

  function ordenar(contenedor: Element, orden: string | null) {
    const items = Array.from(contenedor.children) as HTMLElement[];
    items.sort((a, b) => {
      if (orden === 'titulo') {
        return (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '');
      }
      return (b.dataset.fecha ?? '').localeCompare(a.dataset.fecha ?? '');
    });
    items.forEach((item) => contenedor.appendChild(item));
  }

  botonesOrden.forEach((boton) => {
    boton.addEventListener('click', () => {
      const orden = boton.getAttribute('data-orden');
      if (contenedorMuro) ordenar(contenedorMuro, orden);
      if (contenedorTabla) ordenar(contenedorTabla, orden);
      botonesOrden.forEach((b) => b.classList.remove('activo'));
      boton.classList.add('activo');
    });
  });

  botonesVista.forEach((boton) => {
    boton.addEventListener('click', () => {
      const vista = boton.getAttribute('data-vista');
      if (indiceVistas && vista) indiceVistas.setAttribute('data-vista', vista);
      botonesVista.forEach((b) => b.classList.remove('activo'));
      boton.classList.add('activo');
    });
  });

  contenedorMuro?.addEventListener('mousemove', (e) => {
    const marco = (e.target as HTMLElement).closest('.marco') as HTMLElement | null;
    if (!marco) return;
    const cartel = marco.querySelector('.cartel') as HTMLElement | null;
    const rect = marco.getBoundingClientRect();
    let x = e.clientX - rect.left;
    let y = e.clientY - rect.top;
    if (cartel) {
      const mitadAncho = cartel.offsetWidth / 2;
      const mitadAlto = cartel.offsetHeight / 2;
      x = Math.min(Math.max(x, mitadAncho), rect.width - mitadAncho);
      y = Math.min(Math.max(y, mitadAlto), rect.height - mitadAlto);
    }
    marco.style.setProperty('--x', `${x}px`);
    marco.style.setProperty('--y', `${y}px`);
  });
</script>
