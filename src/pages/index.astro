---
import Base from '../layouts/Base.astro';
import { getTodasLasEntradas, extraerSlugsReferenciados } from '../lib/entradas';
import { formatearFecha, rutaMedia } from '../lib/formato';

const entradas = await getTodasLasEntradas();

const conteoBacklinks = new Map<string, number>();
for (const e of entradas) {
  for (const slug of extraerSlugsReferenciados(e.body)) {
    conteoBacklinks.set(slug, (conteoBacklinks.get(slug) ?? 0) + 1);
  }
}

const items = entradas
  .map((e) => {
    const imagen = e.data.archivo ?? e.data.imagenes?.[0] ?? null;
    return {
      slug: e.slug,
      tipo: e.tipo,
      titulo: e.data.titulo,
      fecha: e.data.fecha as Date,
      estado: e.data.estado as string,
      conexiones: conteoBacklinks.get(e.slug) ?? 0,
      imagen,
    };
  })
  .sort((a, b) => b.fecha.getTime() - a.fecha.getTime());
---
<Base titulo="índice">
  <div class="controles-indice">
    <span>ordenar por</span>
    <button type="button" data-orden="fecha" class="activo">fecha</button>
    <button type="button" data-orden="titulo">título</button>
  </div>
  <ul class="muro" id="indice">
    {items.map((item) => (
      <li class:list={['celda', item.imagen ? 'imagen' : 'nota']} data-fecha={item.fecha.toISOString()} data-titulo={item.titulo}>
        {item.imagen && (
          <a class="marco" href={`/${item.tipo}/${item.slug}`}>
            <img src={rutaMedia(item.imagen)} alt="" loading="lazy" />
          </a>
        )}
        <div class="contenido">
          <a class="titulo" href={`/${item.tipo}/${item.slug}`}>{item.titulo}</a>
          <span class="ficha">{item.tipo} · {item.estado} · {formatearFecha(item.fecha)}</span>
          {item.conexiones > 0 && (
            <span class="conexiones">{item.conexiones} {item.conexiones === 1 ? 'conexión' : 'conexiones'}</span>
          )}
        </div>
      </li>
    ))}
  </ul>
</Base>
<style>
  .controles-indice {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #777;
    margin-bottom: 3rem;
  }
  .controles-indice button {
    font: inherit;
    background: none;
    border: none;
    color: #777;
    cursor: pointer;
    padding: 0 0.3rem;
    text-decoration: underline;
  }
  .controles-indice button.activo {
    color: #111;
    text-decoration: none;
    font-weight: 600;
  }
  .muro {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-flow: row dense;
    column-gap: 2rem;
    row-gap: 7rem;
  }
  .celda {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .celda.nota {
    grid-column: span 2;
    justify-content: center;
    min-height: 12rem;
    border-top: 1px solid #e8e6e1;
    padding-top: 1.5rem;
  }
  .marco {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .marco img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fafaf8;
  }
  .contenido {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .titulo {
    font-size: 1.05rem;
    font-weight: 500;
    color: #141414;
    text-decoration: none;
  }
  .titulo:hover {
    text-decoration: underline;
  }
  .nota .titulo {
    font-size: 1.2rem;
  }
  .ficha {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #999;
  }
  .conexiones {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: #b0aca2;
  }
  .conexiones::before {
    content: '⌁ ';
  }
  @media (max-width: 87rem) {
    .muro {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 65rem) {
    .muro {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 5rem;
    }
  }
  @media (max-width: 48rem) {
    .muro {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.25rem;
      row-gap: 3.5rem;
    }
  }
  @media (max-width: 28rem) {
    .muro {
      grid-template-columns: 1fr;
    }
    .celda.nota {
      grid-column: span 1;
    }
  }
</style>
<script>
  const contenedor = document.getElementById('indice');
  const botones = document.querySelectorAll('.controles-indice button');
  if (contenedor) {
    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const orden = boton.getAttribute('data-orden');
        const items = Array.from(contenedor.children) as HTMLElement[];
        items.sort((a, b) => {
          if (orden === 'titulo') {
            return (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '');
          }
          return (b.dataset.fecha ?? '').localeCompare(a.dataset.fecha ?? '');
        });
        items.forEach((item) => contenedor.appendChild(item));
        botones.forEach((b) => b.classList.remove('activo'));
        boton.classList.add('activo');
      });
    });
  }
</script>
