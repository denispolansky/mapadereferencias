---
import Base from '../layouts/Base.astro';
---
<Base titulo="buscar">
  <div class="buscador">
    <input type="search" id="campo-busqueda" class="obra" placeholder="título, texto o etiqueta…" autofocus />
    <p id="estado-busqueda" class="estado"></p>
  </div>
  <ul id="resultados" class="columna"></ul>
</Base>
<style is:global>
  .buscador {
    max-width: 44rem;
    margin: 1rem 0 3rem;
  }
  #campo-busqueda {
    width: 100%;
    font-size: 2rem;
    font-weight: 400;
    color: #141414;
    padding: 0.5rem 0 0.9rem;
    border: none;
    border-bottom: 1px solid #ccc;
    outline: none;
    background: none;
  }
  #campo-busqueda::placeholder {
    color: #b0aca2;
  }
  #campo-busqueda:focus {
    border-bottom-color: var(--acento);
  }
  .estado {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: #999;
    margin: 0.75rem 0 0;
  }
  #resultados {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #resultados li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid #eee;
  }
  #resultados .titulo {
    color: #141414;
    text-decoration: none;
    font-size: 1.15rem;
  }
  #resultados .titulo:hover { color: var(--acento); }
  #resultados .meta {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #999;
  }
  #resultados p {
    margin: 0.25rem 0 0;
    color: #444;
    font-size: 0.9rem;
  }
</style>
<script>
  interface ItemBusqueda {
    slug: string;
    tipo: string;
    titulo: string;
    etiquetas: string[];
    extracto: string;
    texto: string;
  }

  const campo = document.getElementById('campo-busqueda') as HTMLInputElement;
  const lista = document.getElementById('resultados') as HTMLUListElement;
  const estado = document.getElementById('estado-busqueda') as HTMLParagraphElement;
  let indice: ItemBusqueda[] = [];

  fetch('/indice-busqueda.json')
    .then((r) => r.json())
    .then((datos: ItemBusqueda[]) => {
      indice = datos;
      estado.textContent = `${indice.length} entradas indexadas`;
    });

  function render(items: ItemBusqueda[]) {
    lista.innerHTML = '';
    for (const item of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'titulo obra';
      a.href = `/${item.tipo}/${item.slug}`;
      a.textContent = item.titulo;
      const meta = document.createElement('span');
      meta.className = 'meta';
      meta.textContent = item.tipo;
      const p = document.createElement('p');
      p.textContent = item.extracto;
      li.appendChild(a);
      li.appendChild(meta);
      li.appendChild(p);
      lista.appendChild(li);
    }
  }

  campo.addEventListener('input', () => {
    const consulta = campo.value.trim().toLowerCase();
    if (!consulta) {
      lista.innerHTML = '';
      estado.textContent = `${indice.length} entradas indexadas`;
      return;
    }
    const resultados = indice.filter((item) => item.texto.includes(consulta));
    estado.textContent = `${resultados.length} resultado${resultados.length === 1 ? '' : 's'}`;
    render(resultados);
  });
</script>
