---
import { ruta } from '../lib/rutas';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const rutaActual = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} · archivo vivo</title>
  </head>
  <body>
    <header class="cabecera">
      <a class="marca" href={ruta("/")}>archivo vivo</a>
      <nav>
        <a href={ruta('/')} aria-current={rutaActual.replace(/\/$/, '') === ruta('/').replace(/\/$/, '') ? 'page' : undefined}>índice</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      @font-face {
        font-family: 'Archivo';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/mapadereferencias/fonts/archivo-variable.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Archivo';
        font-style: italic;
        font-weight: 400 700;
        font-display: swap;
        src: url('/mapadereferencias/fonts/archivo-italic.woff2') format('woff2');
      }
      :root {
        --acento: #141414;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 1.1rem;
        color: #141414;
        background: #fff;
        line-height: 1.6;
      }
      .obra {
        font-family: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-style: italic;
      }
      .cabecera {
        display: flex;
        align-items: baseline;
        gap: 1.75rem;
        padding: 2rem 2.5rem 2.5rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .cabecera .marca {
        color: #999;
        text-decoration: none;
      }
      .cabecera .marca:hover {
        color: var(--acento);
      }
      .cabecera nav {
        display: flex;
        gap: 1.25rem;
      }
      .cabecera nav a {
        color: #999;
        text-decoration: none;
      }
      .cabecera nav a:hover {
        color: var(--acento);
      }
      .cabecera nav a[aria-current='page'] {
        color: #141414;
      }
      main {
        padding: 0 2.5rem 7rem;
      }
      .columna {
        max-width: 38rem;
      }
      a { color: #141414; }
      a:hover { color: var(--acento); }
      img { max-width: 100%; height: auto; display: block; }
      a.wikilink {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dotted #141414;
        transition: border-bottom-style 0.15s ease, color 0.15s ease;
      }
      a.wikilink:hover,
      a.wikilink:focus-visible {
        color: var(--acento);
        border-bottom-color: var(--acento);
        border-bottom-style: solid;
      }
      .wikilink-roto {
        color: #999;
        border-bottom: 1px dotted #999;
        cursor: help;
      }
      @media (max-width: 40rem) {
        .cabecera {
          padding: 1.5rem 1.25rem 2rem;
        }
        main {
          padding: 0 1.25rem 5rem;
        }
      }
    </style>
  </body>
</html>
