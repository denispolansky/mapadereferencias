---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} · archivo vivo</title>
  </head>
  <body>
    <header class="cabecera">
      <a class="marca" href="/">archivo vivo</a>
      <nav>
        <a href="/" aria-current={ruta === '/' ? 'page' : undefined}>índice</a>
        <a href="/diario" aria-current={ruta === '/diario' ? 'page' : undefined}>diario</a>
        <a href="/buscar" aria-current={ruta === '/buscar' ? 'page' : undefined}>buscar</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      @font-face {
        font-family: 'Lora';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/lora-variable.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Lora';
        font-style: italic;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/lora-italic.woff2') format('woff2');
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: 'Lora', Georgia, 'Times New Roman', serif;
        font-size: 1.125rem;
        color: #141414;
        background: #fff;
        line-height: 1.65;
      }
      .cabecera {
        display: flex;
        align-items: baseline;
        gap: 1.75rem;
        padding: 2rem 2.5rem 2.5rem;
        font-family: ui-monospace, monospace;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .cabecera .marca {
        color: #999;
        text-decoration: none;
      }
      .cabecera .marca:hover {
        color: #141414;
      }
      .cabecera nav {
        display: flex;
        gap: 1.25rem;
      }
      .cabecera nav a {
        color: #999;
        text-decoration: none;
      }
      .cabecera nav a:hover {
        color: #141414;
      }
      .cabecera nav a[aria-current='page'] {
        color: #141414;
      }
      main {
        padding: 0 2.5rem 7rem;
      }
      .columna {
        max-width: 38rem;
      }
      a { color: #141414; }
      img { max-width: 100%; height: auto; display: block; }
      a.wikilink {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dotted #141414;
        transition: border-bottom-style 0.15s ease;
      }
      a.wikilink:hover,
      a.wikilink:focus-visible {
        border-bottom-style: solid;
      }
      .wikilink-roto {
        color: #999;
        border-bottom: 1px dotted #999;
        cursor: help;
      }
      @media (max-width: 40rem) {
        .cabecera {
          padding: 1.5rem 1.25rem 2rem;
        }
        main {
          padding: 0 1.25rem 5rem;
        }
      }
    </style>
  </body>
</html>
