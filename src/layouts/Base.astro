---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} · archivo vivo</title>
  </head>
  <body>
    <div class="armazon">
      <aside class="sidebar">
        <a class="marca" href="/">archivo<span class="salto">{' '}</span>vivo</a>
        <nav>
          <a href="/" aria-current={ruta === '/' ? 'page' : undefined}>índice</a>
          <a href="/diario" aria-current={ruta === '/diario' ? 'page' : undefined}>diario</a>
          <a href="/buscar" aria-current={ruta === '/buscar' ? 'page' : undefined}>buscar</a>
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <style is:global>
      @font-face {
        font-family: 'Lora';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/lora-variable.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Lora';
        font-style: italic;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/lora-italic.woff2') format('woff2');
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: 'Lora', Georgia, 'Times New Roman', serif;
        font-size: 1.125rem;
        color: #141414;
        background: #fff;
        line-height: 1.65;
      }
      .armazon {
        display: flex;
        align-items: flex-start;
      }
      .sidebar {
        flex: 0 0 9rem;
        position: sticky;
        top: 0;
        padding: 2rem 1.5rem 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        font-family: ui-monospace, monospace;
        font-size: 0.78rem;
      }
      .sidebar .marca {
        color: #999;
        text-decoration: none;
        letter-spacing: 0.02em;
      }
      .sidebar .marca:hover {
        color: #141414;
      }
      .sidebar .marca .salto {
        display: block;
        width: 0;
        font-size: 0;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .sidebar nav a {
        color: #999;
        text-decoration: none;
        width: fit-content;
      }
      .sidebar nav a:hover {
        color: #141414;
      }
      .sidebar nav a[aria-current='page'] {
        color: #141414;
      }
      main {
        flex: 1 1 auto;
        min-width: 0;
        padding: 3rem 3rem 7rem 0;
      }
      .columna {
        max-width: 38rem;
      }
      a { color: #141414; }
      img { max-width: 100%; height: auto; display: block; }
      a.wikilink {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dotted #141414;
        transition: border-bottom-style 0.15s ease;
      }
      a.wikilink:hover,
      a.wikilink:focus-visible {
        border-bottom-style: solid;
      }
      .wikilink-roto {
        color: #999;
        border-bottom: 1px dotted #999;
        cursor: help;
      }
      @media (max-width: 48rem) {
        .armazon {
          flex-direction: column;
        }
        .sidebar {
          flex: 0 0 auto;
          position: static;
          flex-direction: row;
          align-items: baseline;
          justify-content: space-between;
          width: 100%;
          padding: 2rem 1.25rem 1.5rem;
          gap: 1rem;
        }
        .sidebar .marca .salto {
          display: inline;
          width: auto;
          font-size: inherit;
        }
        .sidebar nav {
          flex-direction: row;
          gap: 1rem;
        }
        main {
          padding: 0 1.25rem 5rem;
        }
      }
    </style>
  </body>
</html>
